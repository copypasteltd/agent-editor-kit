{
  "id": "aek.optical.silver-glass",
  "version": "1.0.0",
  "name": {
    "zh": "银色玻璃",
    "en": "Silver glass"
  },
  "license_spdx": "MIT",
  "author": "agent editor kit",
  "variables": [
    {
      "name": "clip_id",
      "type": "string",
      "required": true
    },
    {
      "name": "middle_tick",
      "type": "integer",
      "min": 1,
      "required": true
    },
    {
      "name": "end_tick",
      "type": "integer",
      "min": 2,
      "required": true
    }
  ],
  "operations": [
    {
      "op": "update_clip",
      "clip_id": "{{clip_id}}",
      "patch": {
        "effects": [
          {
            "type": "lens_flare",
            "parameters": {
              "intensity": 0.5,
              "x": 0.8,
              "y": 0.18,
              "radius": 0.035,
              "red": 0.75,
              "green": 0.88,
              "blue": 1,
              "brightness": 0.5,
              "streak": 2.6,
              "streak_width": 0.002,
              "halo": 0.08,
              "ghosts": 2,
              "ghost_spacing": 0.6
            },
            "keyframes": [
              {
                "property": "x",
                "keyframes": [
                  {
                    "at_tick": 0,
                    "value": 1.15,
                    "interpolation": "ease_in_out"
                  },
                  {
                    "at_tick": "{{end_tick}}",
                    "value": -0.15,
                    "interpolation": "ease_in_out"
                  }
                ]
              }
            ]
          },
          {
            "type": "bloom",
            "parameters": {
              "intensity": 0.35,
              "threshold": 0.7,
              "knee": 0.1,
              "radius": 2.5,
              "gain": 0.6,
              "red": 1,
              "green": 1,
              "blue": 1
            },
            "keyframes": []
          }
        ]
      }
    }
  ]
}
