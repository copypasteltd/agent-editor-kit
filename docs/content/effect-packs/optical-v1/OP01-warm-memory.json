{
  "id": "aek.optical.warm-memory",
  "version": "1.0.0",
  "name": {
    "zh": "暖光回忆",
    "en": "Warm memory"
  },
  "license_spdx": "MIT",
  "author": "agent editor kit",
  "variables": [
    {
      "name": "clip_id",
      "type": "string",
      "required": true
    },
    {
      "name": "middle_tick",
      "type": "integer",
      "min": 1,
      "required": true
    },
    {
      "name": "end_tick",
      "type": "integer",
      "min": 2,
      "required": true
    }
  ],
  "operations": [
    {
      "op": "update_clip",
      "clip_id": "{{clip_id}}",
      "patch": {
        "effects": [
          {
            "type": "light_leak",
            "parameters": {
              "intensity": 0.55,
              "x": 0.1,
              "y": 0.25,
              "radius": 0.35,
              "aspect": 1.8,
              "angle": -25,
              "red": 1.0,
              "green": 0.32,
              "blue": 0.08,
              "brightness": 0.45
            },
            "keyframes": [
              {
                "property": "x",
                "keyframes": [
                  {
                    "at_tick": 0,
                    "value": -0.2,
                    "interpolation": "ease_in_out"
                  },
                  {
                    "at_tick": "{{end_tick}}",
                    "value": 1.15,
                    "interpolation": "ease_in_out"
                  }
                ]
              },
              {
                "property": "intensity",
                "keyframes": [
                  {
                    "at_tick": 0,
                    "value": 0.15,
                    "interpolation": "ease_in_out"
                  },
                  {
                    "at_tick": "{{middle_tick}}",
                    "value": 0.62,
                    "interpolation": "ease_in_out"
                  },
                  {
                    "at_tick": "{{end_tick}}",
                    "value": 0.15,
                    "interpolation": "ease_in_out"
                  }
                ]
              }
            ]
          },
          {
            "type": "halation",
            "parameters": {
              "intensity": 0.45,
              "threshold": 0.48,
              "knee": 0.12,
              "radius": 4,
              "gain": 1.3,
              "red": 1,
              "green": 0.15,
              "blue": 0.03
            },
            "keyframes": []
          }
        ]
      }
    }
  ]
}
